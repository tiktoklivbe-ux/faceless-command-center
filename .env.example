# Copy this file to .env and fill in APP_BASE_URL once you know where this is hosted.
# Everything else (API keys) is entered through the Settings page in the app itself,
# not through this file -- they're stored encrypted in data/app.db.

# Must exactly match the public URL of this app, with no trailing slash.
# Local testing:   http://localhost:8000
# Replit:          https://your-repl-name.your-username.repl.co
# Railway/Render:  https://your-app.up.railway.app  (or whatever they assign you)
APP_BASE_URL=http://localhost:8000

# Optional: override the port (Railway/Render set this automatically).
PORT=8000
